// Non-blocking HTTP on sock.nb_srv (select-based concurrent connections)
// use cnx.nhttp

use std.str

en Status {
  ok = 200,
  created = 201,
  no_content = 204,
  bad_request = 400,
  unauthorized = 401,
  forbidden = 403,
  not_found = 404,
  method_not_allowed = 405,
  conflict = 409,
  server_error = 500
}

pub rec Req {
  method: str,
  path: str,
  query: str,
  body: str
}

pub rec Res {
  status: Status,
  body: str,
  ctype: str
}

pub fn Req.get() -> str =  self.method == "GET" ? self.path : ""
pub fn Req.post() -> str =  self.method == "POST" ? self.path : ""

pub fn success(body: str, ctype: str) -> Res {
  ret Res { status: Status.ok, body: body, ctype: ctype }
}

pub fn fail(status: Status, body: str, ctype: str) -> Res {
  ret Res { status: status, body: body, ctype: ctype }
}

pub fn format_response(r: Res) -> str {
  val code = 500
  val reason = "Error"
  if r.status == Status.ok { code = 200; reason = "OK" }
  if r.status == Status.created { code = 201; reason = "Created" }
  if r.status == Status.no_content { code = 204; reason = "No Content" }
  if r.status == Status.bad_request { code = 400; reason = "Bad Request" }
  if r.status == Status.unauthorized { code = 401; reason = "Unauthorized" }
  if r.status == Status.forbidden { code = 403; reason = "Forbidden" }
  if r.status == Status.not_found { code = 404; reason = "Not Found" }
  if r.status == Status.method_not_allowed { code = 405; reason = "Method Not Allowed" }
  if r.status == Status.conflict { code = 409; reason = "Conflict" }
  if r.status == Status.server_error { code = 500; reason = "Internal Server Error" }
  val n = len(r.body)
  ret fmt(
    "HTTP/1.1 ", code, " ", reason, "\r\n",
    "Content-Type: ", r.ctype, "\r\n",
    "Content-Length: ", n, "\r\n",
    "Connection: close\r\n\r\n",
    r.body
  )
}

pub fn parse_req(raw: str) -> Req {
  val method = "GET"
  val path = "/"
  val query = ""
  val body = ""
  if len(raw) == 0 {
    ret Req { method: method, path: path, query: query, body: body }
  }
  if str.has(raw, "\r\n\r\n") {
    val parts = str.split(raw, "\r\n\r\n")
    if len(parts) > 1 { body = parts[1] }
    val head = parts[0]
    val lines = str.split(head, "\r\n")
    if len(lines) > 0 {
      val bits = str.split(lines[0], " ")
      if len(bits) > 0 { method = bits[0] }
      if len(bits) > 1 {
        path = bits[1]
        if str.has(path, "?") {
          val pq = str.split(path, "?")
          path = pq[0]
          if len(pq) > 1 { query = pq[1] }
        }
      }
    }
  } else {
    val lines = str.split(raw, "\n")
    if len(lines) > 0 {
      val line = str.trim(lines[0])
      val bits = str.split(line, " ")
      if len(bits) > 0 { method = bits[0] }
      if len(bits) > 1 { path = bits[1] }
    }
  }
  ret Req { method: method, path: path, query: query, body: body }
}

// Non-blocking concurrent server (host select loop).
pub fn srv(port: long, handler: fn(Req) -> Res) {
  sock.nb_srv(port, handler)
}

// Async-style API: ~~ = async fn, ~ = await (suspend points for I/O).
// Lowered to the same non-blocking srv today; await marks I/O boundaries.
pub ~~ fn asrv(port: long, handler: fn(Req) -> Res) {
  sock.nb_srv(port, handler)
}

// --- HTTP client (REST) ---

pub rec ClientRes {
  status: long,
  body: str,
  ctype: str
}

fn parse_url(url: str) -> {str: str} {
  var host = "127.0.0.1"
  var port = "80"
  var path = "/"
  var scheme = "http"
  var rest = url
  if str.has(rest, "://") {
    val parts = str.split(rest, "://")
    if len(parts) > 0 { scheme = parts[0] }
    if len(parts) > 1 { rest = parts[1] }
    if scheme == "https" { port = "443" }
  }
  if str.has(rest, "/") {
    val parts = str.split(rest, "/")
    host = parts[0]
    path = "/"
    if len(parts) > 1 {
      var i = 1
      lp i < len(parts) {
        if i > 1 { path = path + "/" }
        path = path + parts[i]
        i = i + 1
      }
    }
  } else {
    host = rest
    path = "/"
  }
  if str.has(host, ":") {
    val hp = str.split(host, ":")
    host = hp[0]
    if len(hp) > 1 { port = hp[1] }
  }
  ret { "host": host, "port": port, "path": path, "scheme": scheme }
}

fn parse_client_res(raw: str) -> ClientRes {
  var status: long = 0
  var body = ""
  var ctype = "text/plain"
  if len(raw) == 0 {
    ret ClientRes { status: 0, body: "", ctype: ctype }
  }
  if str.has(raw, "\r\n\r\n") {
    val parts = str.split(raw, "\r\n\r\n")
    val head = parts[0]
    if len(parts) > 1 { body = parts[1] }
    val lines = str.split(head, "\r\n")
    if len(lines) > 0 {
      val bits = str.split(lines[0], " ")
      if len(bits) > 1 { status = parse(bits[1]) }
    }
    var i = 1
    lp i < len(lines) {
      val line = lines[i]
      if str.starts(line, "Content-Type:") {
        val cparts = str.split(line, ":")
        if len(cparts) > 1 { ctype = str.trim(cparts[1]) }
      }
      if str.starts(line, "content-type:") {
        val cparts = str.split(line, ":")
        if len(cparts) > 1 { ctype = str.trim(cparts[1]) }
      }
      i = i + 1
    }
  } else {
    body = raw
  }
  ret ClientRes { status: status, body: body, ctype: ctype }
}

fn format_request(method: str, path: str, host: str, body: str, ctype: str) -> str {
  val n = len(body)
  if n > 0 {
    ret fmt(
      method, " ", path, " HTTP/1.1\r\n",
      "Host: ", host, "\r\n",
      "Content-Type: ", ctype, "\r\n",
      "Content-Length: ", n, "\r\n",
      "Connection: close\r\n\r\n",
      body
    )
  }
  ret fmt(
    method, " ", path, " HTTP/1.1\r\n",
    "Host: ", host, "\r\n",
    "Connection: close\r\n\r\n"
  )
}

// url e.g. "http://127.0.0.1:8766/api" or "127.0.0.1:8766/api"
pub fn request(method: str, url: str, body: str, ctype: str) -> ClientRes {
  val u = parse_url(url)
  val host = u["host"]
  val path = u["path"]
  val port = parse(u["port"])
  val scheme = u["scheme"]
  val fd = if scheme == "https" {
    sock.connect_tls(host, port)
  } else {
    sock.connect(host, port)
  }
  if fd < 0 {
    ret ClientRes { status: 0, body: "connect failed", ctype: "text/plain" }
  }
  val req = format_request(method, path, host, body, ctype)
  sock.send(fd, req)
  val raw = sock.recv_all(fd)
  sock.close(fd)
  ret parse_client_res(raw)
}

pub fn get(url: str) -> ClientRes {
  ret request("GET", url, "", "text/plain")
}

pub fn post(url: str, body: str, ctype: str) -> ClientRes {
  ret request("POST", url, body, ctype)
}

pub fn put(url: str, body: str, ctype: str) -> ClientRes {
  ret request("PUT", url, body, ctype)
}

pub fn delete(url: str) -> ClientRes {
  ret request("DELETE", url, "", "text/plain")
}
