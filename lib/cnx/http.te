// Optional package: use http
// Types + parse/format + srv/client on host sock.*

use std.str

pub fix TXT_PLAIN = "text/plain; charset=utf-8"
pub fix APP_JSON = "application/json; charset=utf-8"

en Status {
  ok = 200,
  created = 201,
  no_content = 204,
  bad_request = 400,
  unauthorized = 401,
  forbidden = 403,
  not_found = 404,
  method_not_allowed = 405,
  conflict = 409,
  server_error = 500
}

pub rec Req {
  method: str,
  path: str,
  query: str,
  body: str
}

pub rec Res {
  status: Status,
  body: str,
  ctype: str
}

pub rec Rsp {
  status: Status,
  body: str,
  ctype: str
}

pub fn Req.get() -> str =  self.method == "GET" ? self.path : ""
pub fn Req.post() -> str =  self.method == "POST" ? self.path : ""


pub fn success(body: str, ctype: str) -> Rsp {
  ret Rsp { status: Status.ok, body: body, ctype: ctype }
}

pub fn fail(status: Status, body: str, ctype: str) -> Rsp {
  ret Rsp { status: status, body: body, ctype: ctype }
}

pub fn formatRsp(r: Res) -> str {
  val code = 500
  val reason = "Error"
  if r.status == Status.ok { code = 200; reason = "OK" }
  if r.status == Status.created { code = 201; reason = "Created" }
  if r.status == Status.no_content { code = 204; reason = "No Content" }
  if r.status == Status.bad_request { code = 400; reason = "Bad Request" }
  if r.status == Status.unauthorized { code = 401; reason = "Unauthorized" }
  if r.status == Status.forbidden { code = 403; reason = "Forbidden" }
  if r.status == Status.not_found { code = 404; reason = "Not Found" }
  if r.status == Status.method_not_allowed { code = 405; reason = "Method Not Allowed" }
  if r.status == Status.conflict { code = 409; reason = "Conflict" }
  if r.status == Status.server_error { code = 500; reason = "Internal Server Error" }
  val n = len(r.body)
  ret fmt(
    "HTTP/1.1 ", code, " ", reason, "\r\n",
    "Content-Type: ", r.ctype, "\r\n",
    "Content-Length: ", n, "\r\n",
    "Connection: close\r\n\r\n",
    r.body
  )
}

pub fn formatResponse(r: Rsp) -> str {
  val rr = Res { status: r.status, body: r.body, ctype: r.ctype }
  ret formatRsp(rr)
}

pub fn parseReq(raw: str) -> Req {
  val method = "GET"
  val path = "/"
  val query = ""
  val body = ""
  if len(raw) == 0 {
    ret Req { method: method, path: path, query: query, body: body }
  }
  if str.has(raw, "\r\n\r\n") {
    val parts = str.split(raw, "\r\n\r\n")
    if len(parts) > 1 { body = parts[1] }
    val head = parts[0]
    val lines = str.split(head, "\r\n")
    if len(lines) > 0 {
      val bits = str.split(lines[0], " ")
      if len(bits) > 0 { method = bits[0] }
      if len(bits) > 1 {
        path = bits[1]
        if str.has(path, "?") {
          val pq = str.split(path, "?")
          path = pq[0]
          if len(pq) > 1 { query = pq[1] }
        }
      }
    }
  } else {
    val lines = str.split(raw, "\n")
    if len(lines) > 0 {
      val line = str.trim(lines[0])
      val bits = str.split(line, " ")
      if len(bits) > 0 { method = bits[0] }
      if len(bits) > 1 { path = bits[1] }
    }
  }
  ret Req { method: method, path: path, query: query, body: body }
}

// Blocks forever. handler: fn(Req) -> Rsp
pub fn srv(port: long, handler: fn(Req) -> Rsp) {
  val ls = sock.listen(port)
  lp true {
    val c = sock.accept(ls)
    if c < 0 { skip }
    val raw = sock.recv(c)
    if len(raw) == 0 {
      sock.close(c)
      skip
    }
    val rq = parseReq(raw)
    val rs = handler(rq)
    sock.send(c, formatResponse(rs))
    sock.close(c)
  }
}

// --- HTTP client (REST) ---

fn parseUrl(url: str) -> {str: str} {
  var host = "127.0.0.1"
  var port = "80"
  var path = "/"
  var scheme = "http"
  var rest = url
  if str.has(rest, "://") {
    val parts = str.split(rest, "://")
    if len(parts) > 0 { scheme = parts[0] }
    if len(parts) > 1 { rest = parts[1] }
    if scheme == "https" { port = "443" }
  }
  if str.has(rest, "/") {
    val parts = str.split(rest, "/")
    host = parts[0]
    path = "/"
    if len(parts) > 1 {
      var i = 1
      lp i < len(parts) {
        if i > 1 { path = path + "/" }
        path = path + parts[i]
        i += 1
      }
    }
  } else {
    host = rest
    path = "/"
  }
  if str.has(host, ":") {
    val hp = str.split(host, ":")
    host = hp[0]
    if len(hp) > 1 { port = hp[1] }
  }
  ret { "host": host, "port": port, "path": path, "scheme": scheme }
}

fn parseClientRsp(raw: str) -> Rsp {
  var status = Status.ok
  var body = ""
  var ctype = "text/plain"
  if len(raw) == 0 {
    ret Rsp { status: Status.no_content, body: "", ctype: ctype }
  }
  if str.has(raw, "\r\n\r\n") {
    val parts = str.split(raw, "\r\n\r\n")
    val head = parts[0]
    if len(parts) > 1 { body = parts[1] }
    val lines = str.split(head, "\r\n")
    if len(lines) > 0 {
      val bits = str.split(lines[0], " ")
      if len(bits) > 1 {
        status = statusFromCode(parse(bits[1]))
      }
    }
    var i = 1
    lp i = 1; i < len(lines); i += 1 {
      val line = lines[i]
      if str.starts(line, "Content-Type:") {
        val cparts = str.split(line, ":")
        if len(cparts) > 1 { ctype = str.trim(cparts[1]) }
      }
      if str.starts(line, "content-type:") {
        val cparts = str.split(line, ":")
        if len(cparts) > 1 { ctype = str.trim(cparts[1]) }
      }
    }
  } else {
    body = raw
  }
  ret Rsp { status: status, body: body, ctype: ctype }
}

fn statusFromCode(code: long) -> Status {
  if code == 200 { ret Status.ok }
  if code == 201 { ret Status.created }
  if code == 204 { ret Status.no_content }
  if code == 400 { ret Status.bad_request }
  if code == 401 { ret Status.unauthorized }
  if code == 403 { ret Status.forbidden }
  if code == 404 { ret Status.not_found }
  if code == 405 { ret Status.method_not_allowed }
  if code == 409 { ret Status.conflict }
  if code == 500 { ret Status.server_error }
  ret Status.ok
}

fn formatRequest(method: str, path: str, host: str, body: str, ctype: str, headers: str) -> str {
  val n = len(body)
  if n > 0 {
    ret fmt(
      method, " ", path, " HTTP/1.1\r\n",
      "Host: ", host, "\r\n",
      "Content-Type: ", ctype, "\r\n",
      "Content-Length: ", n, "\r\n",
      headers,
      "Connection: close\r\n\r\n",
      body
    )
  }
  ret fmt(
    method, " ", path, " HTTP/1.1\r\n",
    "Host: ", host, "\r\n",
    headers,
    "Connection: close\r\n\r\n"
  )
}

// url e.g. "http://127.0.0.1:8766/api" or "127.0.0.1:8766/api"
// headers must contain complete CRLF-terminated HTTP header lines.
pub fn requestWithHeaders(method: str, url: str, body: str, ctype: str, headers: str) -> Rsp {
  val u = parseUrl(url)
  val host = u["host"]
  val path = u["path"]
  val port = parse(u["port"])
  val scheme = u["scheme"]
  val fd = if scheme == "https" {
    sock.connect_tls(host, port)
  } else {
    sock.connect(host, port)
  }
  if fd < 0 {
    ret Rsp { status: Status.no_content, body: "connect failed", ctype: "text/plain" }
  }
  val req = formatRequest(method, path, host, body, ctype, headers)
  sock.send(fd, req)
  val raw = sock.recv_all(fd)
  sock.close(fd)
  ret parseClientRsp(raw)
}

pub fn request(method: str, url: str, body: str, ctype: str) -> Rsp {
  ret requestWithHeaders(method, url, body, ctype, "")
}

pub fn get(url: str) -> Rsp {
  ret request("GET", url, "", "text/plain")
}

pub fn post(url: str, body: str, ctype: str = "application/json", headers: str = "") -> Rsp {
  ret requestWithHeaders("POST", url, body, ctype, headers)
}

pub fn put(url: str, body: str, ctype: str) -> Rsp {
  ret request("PUT", url, body, ctype)
}

pub fn delete(url: str) -> Rsp {
  ret request("DELETE", url, "", "text/plain")
}
