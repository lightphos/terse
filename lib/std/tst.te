// std.tst — unit-test assertions (optional package under lib/)
// use std.tst
//
// Policy: quiet on success. Only print FAIL (and later SKIP).
// Do not print PASS lines. Host runtime tst_report() may print
// "FAILED k of n" when the failure count is non-zero.
//
// Overloads: eq / ne for i64, str, bool (file/line from host sugar).

pub fn eq(got: i64, expected: i64, file: str, line: i64) -> i64 {
  if got != expected {
    pr("FAIL " + file + ":" + line + ": expected " + expected + ", got " + got)
    ret 1
  }
  ret 0
}

pub fn eq(got: str, expected: str, file: str, line: i64) -> i64 {
  if got != expected {
    pr("FAIL " + file + ":" + line + ": expected \"" + expected + "\", got \"" + got + "\"")
    ret 1
  }
  ret 0
}

pub fn eq(got: bool, expected: bool, file: str, line: i64) -> i64 {
  if got != expected {
    if expected {
      pr("FAIL " + file + ":" + line + ": expected true, got false")
    } else {
      pr("FAIL " + file + ":" + line + ": expected false, got true")
    }
    ret 1
  }
  ret 0
}

pub fn ne(got: i64, unexpected: i64, file: str, line: i64) -> i64 {
  if got == unexpected {
    pr("FAIL " + file + ":" + line + ": expected not " + unexpected + ", got " + got)
    ret 1
  }
  ret 0
}

pub fn ne(got: str, unexpected: str, file: str, line: i64) -> i64 {
  if got == unexpected {
    pr("FAIL " + file + ":" + line + ": expected not \"" + unexpected + "\", got \"" + got + "\"")
    ret 1
  }
  ret 0
}

pub fn ne(got: bool, unexpected: bool, file: str, line: i64) -> i64 {
  if got == unexpected {
    pr("FAIL " + file + ":" + line + ": expected values to differ")
    ret 1
  }
  ret 0
}

// No PASS / summary print here — host tst_report() is quiet unless failures > 0.
pub fn report() -> i64 {
  ret 0
}
