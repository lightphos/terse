// Stage-one Terse compiler: an arithmetic expression -> portable C.
// Bootstrap with compiler/tersec.py; compile emitted C with GCC.

use std.fs

Token { kind: i64, text: str }
Node { kind: i64, text: str, left: i64, right: i64 }
ParseState { tokens: [Token], nodes: [Node], pos: i64, root: i64 }

fn token(kind: i64, text: str) -> Token = Token { kind: kind, text: text }
fn node(kind: i64, text: str, left: i64, right: i64) -> Node =
  Node { kind: kind, text: text, left: left, right: right }

fn is_space(ch: i64) -> bool = ch == 32 || ch == 9 || ch == 10 || ch == 13
fn is_digit(ch: i64) -> bool = ch >= 48 && ch <= 57

fn scan(source: str, start: i64) -> [Token] {
  let tokens: [Token] = []
  let pos = start
  let done = false
  lp pos < len(source) && done == false {
    let ch = source[pos]
    if is_space(ch) {
      pos = pos + 1
    } else if is_digit(ch) {
      let begin = pos
      lp pos < len(source) && is_digit(source[pos]) {
        pos = pos + 1
      }
      tokens = push(tokens, token(1, substr(source, begin, pos - begin)))
      0
    } else if ch == 43 {
      tokens = push(tokens, token(2, "+"))
      pos = pos + 1
      0
    } else if ch == 45 {
      tokens = push(tokens, token(3, "-"))
      pos = pos + 1
      0
    } else if ch == 42 {
      tokens = push(tokens, token(4, "*"))
      pos = pos + 1
      0
    } else if ch == 47 {
      tokens = push(tokens, token(5, "/"))
      pos = pos + 1
      0
    } else if ch == 37 {
      tokens = push(tokens, token(6, "%"))
      pos = pos + 1
      0
    } else if ch == 40 {
      tokens = push(tokens, token(7, "("))
      pos = pos + 1
      0
    } else if ch == 41 {
      tokens = push(tokens, token(8, ")"))
      pos = pos + 1
      0
    } else if ch == 125 {
      pos = pos + 1
      done = true
      0
    } else {
      tokens = push(tokens, token(9, substr(source, pos, 1)))
      pos = pos + 1
      done = true
    }
  }
  push(tokens, token(0, ""))
}

fn parse_primary(state: ParseState) -> ParseState {
  let current = state.tokens[state.pos]
  if current.kind == 1 {
    state.nodes = push(state.nodes, node(1, current.text, 0, 0))
    state.root = len(state.nodes) - 1
    state.pos = state.pos + 1
    state
  } else if current.kind == 7 {
    state.pos = state.pos + 1
    state = parse_expr(state)
    if state.tokens[state.pos].kind == 8 {
      state.pos = state.pos + 1
      state
    } else {
      pr("tc: expected closing parenthesis")
      state
    }
  } else {
    pr("tc: expected integer or parenthesized expression")
    state
  }
}

fn parse_term(state: ParseState) -> ParseState {
  state = parse_primary(state)
  let keep_parsing = true
  lp keep_parsing == true {
    let operation = state.tokens[state.pos]
    if operation.kind == 4 || operation.kind == 5 || operation.kind == 6 {
      let left = state.root
      state.pos = state.pos + 1
      state = parse_primary(state)
      state.nodes = push(state.nodes, node(2, operation.text, left, state.root))
      state.root = len(state.nodes) - 1
    } else {
      keep_parsing = false
    }
  }
  state
}

fn parse_expr(state: ParseState) -> ParseState {
  state = parse_term(state)
  let keep_parsing = true
  lp keep_parsing == true {
    let operation = state.tokens[state.pos]
    if operation.kind == 2 || operation.kind == 3 {
      let left = state.root
      state.pos = state.pos + 1
      state = parse_term(state)
      state.nodes = push(state.nodes, node(2, operation.text, left, state.root))
      state.root = len(state.nodes) - 1
    } else {
      keep_parsing = false
    }
  }
  state
}

fn emit_node(nodes: [Node], index: i64) -> str {
  let current = nodes[index]
  if current.kind == 1 {
    current.text
  } else {
    "(" + emit_node(nodes, current.left) + current.text + emit_node(nodes, current.right) + ")"
  }
}

fn expression_start(source: str) -> i64 {
  let pos = 0
  let found = false
  lp pos < len(source) && found == false {
    let ch = source[pos]
    if ch == 61 || ch == 123 {
      pos = pos + 1
      found = true
    } else {
      pos = pos + 1
    }
  }
  pos
}

fn compile_file(source_path: str, output_path: str) -> i64 {
  let source = fs.read_text(source_path)
  let tokens = scan(source, expression_start(source))
  let initial = ParseState { tokens: tokens, nodes: [], pos: 0, root: 0 }
  let parsed = parse_expr(initial)
  if len(parsed.nodes) == 0 || parsed.tokens[parsed.pos].kind != 0 {
    2
  } else {
    let expression = emit_node(parsed.nodes, parsed.root)
    let c_source = "#include <stdint.h>\n#include <stdio.h>\nint main(void) {\n  int64_t result = " + expression + ";\n  printf(\"%lld\\n\", (long long)result);\n  return 0;\n}\n"
    let c_path = output_path + ".c"
    fs.write_text(c_path, c_source)
    gcc.compile(c_path, output_path)
  }
}

go {
  let source_path = env("TERSE_SOURCE")
  let output_path = env("TERSE_OUTPUT")
  if len(source_path) == 0 || len(output_path) == 0 {
    pr("tc: invoke through ./tc; run ./tc --help for usage")
    1
  } else {
    let status = compile_file(source_path, output_path)
    if status == 0 {
      pr("TC_OK")
      0
    } else if status == 2 {
      pr("TC_UNSUPPORTED")
      0
    } else {
      pr("TC_GCC_ERROR")
      status
    }
  }
}
