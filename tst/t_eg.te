use std.tst
use eg


fn t_double() { tst.eq(double(5), 10) }
fn t_sum() { tst.eq(sum([1, 2, 3]), 6) }
fn t_classify_zero() { tst.eq(classify(0), "zero") }
fn t_classify_neg() { tst.eq(classify(-5), "negative") }
fn t_classify_pos() { tst.eq(classify(10), "positive") }
fn t_pipe_map_sum() { tst.eq([1, 2, 3] |> map(double) |> sum(), 12) }
