use std.tst
use lists_width

fn t_sum_i32() {
  tst.eq(sum_i32([1, 2, 3]), 6)
}

fn t_sum_i64() {
  tst.eq(sum_i64([10, 20, 12]), 42)
}

fn t_push_len() {
  tst.eq(push_demo(), 3)
}

fn t_f64_sum() {
  // compare via integer scale to avoid flt eq helpers
  val s = sum_f64([1.5, 2.5])
  tst.eq(s == 4.0, true)
}

fn t_index_i32() {
  val xs: [int] = [7, 8, 9]
  tst.eq(xs[1], 8)
  tst.eq(len(xs), 3)
}

fn t_char_list() {
  val cs: [chr] = [65, 66]
  tst.eq(cs[0], 65)
  tst.eq(len(cs), 2)
}

fn t_flt_list() {
  val xs: [flt] = [1.5, 2.5]
  tst.eq(xs[0] == 1.5, true)
  tst.eq(xs[1] == 2.5, true)
  tst.eq(len(xs), 2)
}

fn t_byte_list() {
  val xs: [byte] = [1, 255]
  tst.eq(xs[0], 1)
  tst.eq(xs[1], 255)
  tst.eq(len(xs), 2)
}

fn t_bool_list() {
  val xs: [bool] = [true, false]
  tst.eq(xs[0], true)
  tst.eq(xs[1], false)
  tst.eq(len(xs), 2)
}

fn twice_list_item(n: long) -> long = n * 2

fn t_map() {
  val xs = map([3, 4], twice_list_item)
  tst.eq(len(xs), 2)
  tst.eq(xs[0], 6)
  tst.eq(xs[1], 8)
}
