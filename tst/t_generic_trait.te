use std.tst

tr Eq[T] {
  fn eq(other: T) -> bool
}

tr Show[T] {
  fn str() -> str
}

rec Pt {
  x: i64,
  y: i64
}

fn Pt.eq(other: Pt) -> bool =
  self.x == other.x && self.y == other.y

fn Pt.str() -> str =
  fmt(self.x, ",", self.y)

fn t_eq_same() {
  val a = Pt { x: 1, y: 2 }
  val b = Pt { x: 1, y: 2 }
  tst.eq(a.eq(b), true)
}

fn t_eq_diff() {
  val a = Pt { x: 1, y: 2 }
  val b = Pt { x: 3, y: 4 }
  tst.eq(a.eq(b), false)
}

fn t_show() {
  val a = Pt { x: 3, y: 4 }
  tst.eq(a.str(), "3,4")
}
