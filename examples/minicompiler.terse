// ============================================================
// Mini-compiler written in Terse  (v0.1 subset)
// ============================================================
//
// Source language
// ---------------
//   expr ::= lit(n) | add(expr, expr) | mul(expr, expr)
//
// Example program
// ---------------
//   mul( add(lit(3), lit(4)), add(lit(5), lit(6)) )
//   ≡  (3 + 4) * (5 + 6)  →  77
//
// Compiler pipeline demonstrated
// ------------------------------
//   1. Frontend / AST construction
//        Nested calls to lit / add / mul  =  the abstract syntax tree
//   2. Compile stage
//        compile(tree)  – currently identity.
//        (With strings this stage would emit C or bytecode.)
//   3. Run / backend
//        The value of the compiled form is the result.
//
// Why interpretation instead of codegen?
// --------------------------------------
// Terse v0.1 has no string operations or file I/O, so a program
// cannot yet build and write a .c file. The *shape* of the
// compiler is real; only the final emit step is replaced by
// direct evaluation. When strings land, swap the bodies of
// lit/add/mul for emitters and this becomes a true compiler.
//
// ============================================================

// ----- AST node constructors (also act as interpreters) -----

fn lit(n: i64) -> i64 = n

fn add(left: i64, right: i64) -> i64 = left + right

fn mul(left: i64, right: i64) -> i64 = left * right

// ----- Compile stage (placeholder for future codegen) -----

fn compile(tree: i64) -> i64 = tree

// ----- Sample source programs (written as AST literals) -----

// (3 + 4) * (5 + 6)
fn program1() -> i64 =
  mul(
    add(lit(3), lit(4)),
    add(lit(5), lit(6))
  )

// 2 * (10 + 3)
fn program2() -> i64 =
  mul(lit(2), add(lit(10), lit(3)))

// 100 + (7 * 8)
fn program3() -> i64 =
  add(lit(100), mul(lit(7), lit(8)))

// ----- Driver: compile + run program1 -----

fn main() -> i64 {
  let ast    = program1()
  let object = compile(ast)   // future: emit C source here
  object                      // run the result
}
