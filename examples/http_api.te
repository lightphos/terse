use std.http, std.db

type User = {id: i64, name: str}

go {
  db.connect(env("DATABASE_URL"))
  http.serve(18081) {
    get "/hello" => "world"
    get "/n" => json(42)
    get "/xs" => json([1, 2, 3])
    get "/users" => json(db.query("SELECT id, name FROM users LIMIT 100"))
    post "/echo" => |body| json(body)
  }
}
