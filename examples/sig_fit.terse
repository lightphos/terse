// sig_fit.terse — implicit interface satisfaction.
// A struct automatically satisfies a trait when it has methods with matching
// signatures. No explicit `fit` / `as` declaration is needed.

Point { x: i64, y: i64 }

fn Point.show() -> i64 { pr(self.x + " " + self.y) }
fn Point.add() -> i64 { self.x + self.y }
fn Point.str() -> str {
  "Point { x: " + self.x + ", y: " + self.y + " }"
}
fn Point.cord() -> i64 {
  self.x + self.y
}

tr Printable {
  fn str() -> str
}

tr Coordinate {
  fn cord() -> i64
}

fn print(p: Printable) {
  pr("poly " + p.str())
}

fn main() -> i64 {
    let p = Point {x: 3, y: 2};
    p.show()
    print(p)
    pr(p.add())
    pr(" -> " + p.cord())
    p.x
 }
