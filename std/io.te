// std.io — file text I/O (host runtime)
//
// use std.io
//
//   io.in(path) -> str              // read whole file as text
//   io.out(path, text) -> i64       // write text; returns bytes written
//
// Aliases (older names, still work without import):
//   fs.read_text(path)
//   fs.write_text(path, text)
