{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terse: Compile",
      "type": "shell",
      "command": "python",
      "args": [
        "compiler/tersec.py",
        "build",
        "${file}",
        "-o",
        "out/${fileBasenameNoExtension}${env:OS == 'Windows_NT' ? '.exe' : ''}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Terse: Run",
      "type": "shell",
      "command": "python",
      "args": [
        "compiler/tersec.py",
        "run",
        "${file}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
