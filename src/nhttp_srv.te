// Non-blocking HTTP demo (cnx.nhttp)
//   python3 compiler/tersec.py build src/nhttp_srv.te -o out/nhttp_srv -f
//   ./out/nhttp_srv
//
//   curl -s http://127.0.0.1:8766/
//   curl -s http://127.0.0.1:8766/api
//   curl -s -X POST -d 'hi' http://127.0.0.1:8766/echo
//
// use cnx.http.*  — open import: success / fail unqualified

use cnx.nhttp
use cnx.http.*

fn handle(r: Req) -> Rsp {
  if r.get() {
    "/" => ret success("hello nonblock\n", "text/plain; charset=utf-8")
    "/api" => ret success("{\"ok\":true,\"mode\":\"nb\"}\n", "application/json; charset=utf-8")
  }
  if r.post() {
    "/echo" => ret success(r.body + "\n", "text/plain; charset=utf-8")
  }
  ret fail(Status.not_found, "not found\n", "text/plain; charset=utf-8")
}

go {
  pr("nhttp non-blocking on :8766 (GET / /api  POST /echo)")
  nhttp.asrv(8766, handle)
}
