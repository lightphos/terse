// Non-blocking HTTP with event-loop await (~~> / ~>)
//   python3 compiler/tersec.py build src/nhttp_srv.te -o out/nhttp_srv -f
//   ./out/nhttp_srv
//
// /api uses ~> tim.wait(100): suspend this connection, select keeps serving others.
// / stays fast under concurrent /api load.

use cnx.nhttp
use cnx.http.*
use time.tim

~~> fn handle(r: Req) -> Rsp {
  if r.get() {
    "/" => ret success("hello nonblock\n", TXT_PLAIN)
    "/api" => {
      ~> tim.wait(100)
      ret success("{\"ok\":true}\n", APP_JSON)
    }
  }
  if r.post() {
    "/echo" => ret success(r.body + "\n", TXT_PLAIN)
  }
  ret fail(Status.not_found, "not found\n", TXT_PLAIN)
}

go {
  pr("nhttp ~~>/~> on :8766 (GET / /api  POST /echo)")
  nhttp.asrv(8766, handle)
}
