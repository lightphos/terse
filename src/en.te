use io.pr

en Colour {
  Red,
  Green,
  Blue
}

en Option {
  Some(i64),
  None
}

en Result {
  Ok(i64),
  Err(str)
}

fn name(c: Colour) -> str =
  if c {
    Colour.Red => "red"
    Colour.Green => "green"
    Colour.Blue => "blue"
  }

fn unwrap(o: Option) -> i64 =
  if o {
    Option.Some(n) => n
    Option.None => 0
  }

fn describe(r: Result) -> str =
  if r {
    Result.Ok(n) => "ok"
    Result.Err(msg) => msg
  }

go {
  val c = Colour.Green
  pr(name(c))

  val o = Option.Some(42)
  pr(unwrap(o))
  pr(unwrap(Option.None))

  val r = Result.Ok(7)
  pr(describe(r))
  pr(describe(Result.Err("boom")))
}
