// loop.terse
// Demonstrates while-style and for-style lp loops and list iteration.

fn sum_while() -> i64 {
  var i = 0
  var sum = 0
  lp i < 5 {
    sum = sum + i
    i = i + 1
  }
  sum
}

fn sum_for() -> i64 {
  var sum = 0
  lp i = 0; i < 10; i = i + 1 {
    sum = sum + i
  }
  sum
}

fn sum_list() -> i64 {
  val list = [1, 2, 3, 4, 5]
  var sum = 0
  var idx = 0
  lp idx < list.len() {
    sum = sum + list[idx]
    idx = idx + 1
  }
  sum
}

fn sum_skip() -> i64 {
  val list = [1, 2, 3, 4, -1, 5, 6]
  var sum = 0
  lp idx = 0; idx < list.len(); idx = idx + 1 {
    if list[idx] < 0 { brk }
    if list[idx] % 2 == 0 { skip }
    sum = sum + list[idx]
  }
  sum
}


go {
  pr("sum_while = " + sum_while())
  pr("sum_for = " + sum_for())
  pr("sum_list = " + sum_list())
  pr("sum_skip = " + sum_skip())
}
// EXPECT: sum_while = 10
// EXPECT: sum_for = 45
// EXPECT: sum_list = 15
// EXPECT: sum_skip = 4