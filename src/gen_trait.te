// T0: non-generic tr still works (see trait.te)
// T1: parametric trait + structural satisfaction after subst

tr Eq[T] {
  fn eq(other: T) -> bool
}

tr Show[T] {
  fn str() -> T
}

rec Point {
  x: i64,
  y: i64
}

fn Point.eq(other: Point) -> bool =
  self.x == other.x && self.y == other.y

fn Point.str() -> str =
  fmt("(", self.x, ",", self.y, ")")

fn same(a: Point, b: Point) -> bool =
  a.eq(b)

fn show(a: Show[Point]) {
  pr("showing " + a.str())
}

go {
  val a = Point { x: 1, y: 2 }
  val b = Point { x: 1, y: 2 }
  pr(same(a, b) ? 1 : 0)
  show(a)
}
