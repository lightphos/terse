// Time demo
//   python3 compiler/tersec.py build src/time_demo.te -o out/time_demo -f && ./out/time_demo

use time.tim

fn on_after() {
  pr("after callback")
}

fn on_before() {
  pr("before deadline ok")
}

go {
  val t0 = tim.mono()
  pr(fmt("now_ms=", tim.now()))
  pr(fmt("now_s=", tim.now_s()))
  pr(fmt("stamp=", tim.fmt("%Y-%m-%d %H:%M:%S", tim.now_s())))

  pr("sleep 50ms...")
  tim.wait(50)
  pr(fmt("elapsed_ms=", tim.elapsed(t0)))

  pr("after 30ms...")
  tim.after(30, on_after)

  val deadline = tim.mono() + 1000
  tim.before(deadline, on_before)
}
