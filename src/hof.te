// Higher-order functions demo
fn apply(f: fn, x: long) -> long = f(x)

fn double(n: long) -> long = n * 2

fn add(a: long, b: long) -> long = a + b

fn useDouble(v: long) -> long {
  val d = double
  ret apply(d, v)
}

fn useAdd(a: long) -> long {
  ret apply(|x| x + 100, a)
}

go {
  val r1 = useDouble(5) // 10
  val r2 = useAdd(7) // 107
  r1 + r2 // 149
}
