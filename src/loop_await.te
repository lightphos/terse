// Event-loop await without a network server.
// ~> tim.wait sleeps when not inside sock.nb_srv_step (same syntax as nhttp).
//
//   python3 compiler/tersec.py build src/loop_await.te -o out/loop_await -f && ./out/loop_await

use time.tim

~~> fn delayed_hello() {
  pr("before wait")
  ~> tim.wait(50)
  pr("after wait")
}

~~> fn two_steps() {
  pr("step1")
  ~> tim.wait(30)
  pr("step2")
  ~> tim.wait(30)
  pr("done")
}

go {
  pr("loop_await demo (no server)")
  delayed_hello()
  two_steps()
  pr("all finished")
}
