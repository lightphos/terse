// loop.terse
// Demonstrates while-style and for-style lp loops and list iteration.

fn sum_while() -> i64 {
  let i = 0
  let sum = 0
  lp i < 5 {
    sum = sum + i
    i = i + 1
  }
  sum
}

fn sum_for() -> i64 {
  let sum = 0
  lp i = 0; i < 10; i = i + 1 {
    sum = sum + i
  }
  sum
}

fn sum_list() -> i64 {
  let list = [1, 2, 3, 4, 5]
  let sum = 0
  let idx = 0
  lp idx < list.len() {
    sum = sum + list[idx]
    idx = idx + 1
  }
  sum
}

go {
  pr("sum_while = " + sum_while())
  pr("sum_for = " + sum_for())
  pr("sum_list = " + sum_list())
}
