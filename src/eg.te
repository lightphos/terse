
rec Point {
  x: long,
  y: long,
}

pub fn double(n: long) -> long = n * 2

pub fn sum(xs: [long]) -> long {
  var total = 0
  lp x:xs {
    total += x
  }
  total
}

pub fn classify(n: long) -> str =
  if n {
    0 => "zero"
    n if n < 0 => "negative"
    _ => "positive"
  }

go {
  val p = Point { x: 3, y: 4 }
  val xs = [1, 2, 3]

  pr(p.x)
  pr(xs |> map(double) |> sum())
  pr(classify(-4))
}
