// Blocking HTTP demo (cnx.http)
//   python3 compiler/tersec.py build src/http_srv.te -o out/http_srv -f
//   ./out/http_srv
//
//   curl -s http://127.0.0.1:8765/
//   curl -s http://127.0.0.1:8765/api
//
// /api sleeps 100ms on the only server thread before responding — concurrent
// clients queue (contrast src/nhttp_srv.te).

use cnx.http.*
use time.tim

fn handle(r: Req) -> Rsp {
  if r.get() {
    "/" => ret success("hello world\n", TXT_PLAIN)
    "/api" => {
      tim.wait(100)
      ret success("{\"ok\":true}\n", APP_JSON)
    }
  }
  if r.post() {
    "/echo" => ret success(r.body + "\n", TXT_PLAIN)
  }
  ret fail(Status.not_found, "not found\n", TXT_PLAIN)
}

go {
  pr("blocking http.srv on :8765 (GET / /api  POST /echo)")
  srv(8765, handle)
}
