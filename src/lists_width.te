// Width-accurate lists: [int], [long], [dbl], [chr], ...

pub fn sum_i32(xs: [int]) -> int {
  var s: int = 0
  lp x: xs {
    s = s + x
  }
  ret s
}

pub fn sum_i64(xs: [long]) -> long {
  var s: long = 0
  lp x: xs {
    s = s + x
  }
  ret s
}

pub fn sum_f64(xs: [dbl]) -> dbl {
  var s: dbl = 0.0
  lp x: xs {
    s = s + x
  }
  ret s
}

pub fn push_demo() -> long {
  var a: [int] = []
  a = a + 10
  a = a + [20, 30]
  ret len(a)
}

go {
  pr(sum_i32([1, 2, 3]))
  pr(sum_i64([10, 20]))
  pr(sum_f64([1.5, 2.5]))
  pr(push_demo())
}
