use cnx.nhttp
use cnx.http.*
use domain.model
use proc.process

fn getUser() -> str {
    val u = process.getUser()
    ret u.name + " <" + u.email + ">"
}

~~> fn handle(r: Req) -> Rsp {
  if r.get() {
    "/" => ret success("app server\n", TXT_PLAIN)
    "/user" => ret success(getUser() + "\n", TXT_PLAIN)
  }
  if r.post() {
    "/echo" => ret success(r.body + "\n", TXT_PLAIN)
  }
  ret fail(Status.not_found, "not found\n", TXT_PLAIN)
}

go {
  pr("app server listening on port 8777")
  nhttp.asrv(8777, handle)
}
