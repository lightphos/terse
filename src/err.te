use std.err

fn error() {
    err("this is an error")
}

fn trapper() {
    error()
    trap e: {
        pr("caught: " + e)
    }
}

fn next(s: bool) {

    if (s) {
        error()
        trap e: { // first trap
            pr("caught in condition: " + e)
            err(e)
        }
    }

    trap e: { // second trap
        pr("caught in next: " + e)
    }
}

go {
    trapper()
    next(true)
    next(false)
}
