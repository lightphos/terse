// String + and minimal fmt
//   python3 compiler/tersec.py build src/fmt.te -o out/fmt
//   ./out/fmt

fix GREETING: str = "Greetings"
fix ANSWER: long = 42

fn line(name: str, n: long) -> str {
  ret fmt(name, " -> ", n)
}

go {
  pr(GREETING + " from Terse")
  pr("answer=" + ANSWER)
  pr(fmt("x=", 3, " y=", 4))
  pr(line("sum", 3 + 4))
  pr(fmt("flag=", true, " done"))
}
