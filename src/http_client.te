// HTTP / HTTPS client demo
//
// Local server (optional):
//   python3 compiler/tersec.py build src/nhttp_srv.te -o out/nhttp_srv -f && ./out/nhttp_srv
//
// Client:
//   python3 compiler/tersec.py build src/http_client.te -o out/http_client -f
//   ./out/http_client
//
// Needs libssl (e.g. apt install libssl-dev) for https://

use cnx.http

go {
  // HTTPS — public site (OpenSSL TLS)
  val hx = http.get("https://example.com/")
  pr(fmt("GET https://example.com/ => ", hx.status, " bytes=", len(hx.body)))
  hx.status == 200 ?  pr("https ok") : pr(fmt("https body: ", hx.body))
  

  // Local HTTP — requires nhttp_srv on :8766
  val r1 = http.get("http://127.0.0.1:8766/")
  pr(fmt("GET http://127.0.0.1:8766/ => ", r1.status, " ", r1.body))

  val r2 = http.get("http://127.0.0.1:8766/api")
  pr(fmt("GET /api => ", r2.status, " ", r2.body))

  val r3 = http.post("http://127.0.0.1:8766/echo", "hello rest", "text/plain")
  pr(fmt("POST /echo => ", r3.status, " ", r3.body))
}
