// A structure automatically satisfies a trait when it has methods with matching
// signatures. 

pub Point { x: long, y: long }

fn Point.show() -> long { pr(self.x + " " + self.y) }
fn Point.add() -> long { self.x + self.y }
fn Point.str() -> str {
  "Point { x: " + self.x + ", y: " + self.y + " }"
}
fn Point.cord() -> long {
  self.x + self.y
}

tr Printable {
  fn str() -> str
}

tr Coordinate {
  fn cord() -> long
}

pub fn origin() -> Point {
  ret Point { x: 0, y: 0 }
}


fn print(p: Printable) {
  pr("poly " + p.str())
}

go {
    val p = Point {x: 3, y: 2}
    p.show()
    print(p)
    pr(p.add())
    pr(" -> " + p.cord())
    p.x
 }
