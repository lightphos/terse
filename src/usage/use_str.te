use std.str

go {
  pr(str.has("terse", "ers"))
  pr(str.starts("terse", "te"))
  pr(str.ends("terse", "se"))
  pr(str.trim("  pad  "))
  pr(str.parse("99"))
  val bits = str.split("x,y,z", ",")
  pr(len(bits))
  pr(str.join(bits, ":"))
  pr(str.up("Hello"))   // "HELLO"
  pr(str.low("Hello"))  // "hello"
  pr(str.up("AbC")) / pr(str.low("AbC"))        // free names too
}
