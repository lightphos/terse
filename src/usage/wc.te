use std.str

pub fn wc(text: str) -> {str:i64} {
  val words = str.split(text, " ")
  var counts: {str:i64} = {:}
  lp w:words {
    if has(counts, w) {
      counts[w] = counts[w] + 1
    } else {
      counts[w] = 1
    }
  }
  ret counts
}

go {
  val counts = wc("one two one three two one")
  pr(counts["one"])
  pr(counts["two"])
  pr(counts["three"])
  pr(len(counts))
}
